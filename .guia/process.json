{
  "schemaVersion": 1,
  "name": "guia-fluxo",
  "projectName": "FuteLista",
  "ids": {
    "featurePrefix": "F",
    "issuePrefix": "I",
    "backlogPrefix": "B",
    "digits": 3
  },
  "chatTitleFormat": "{id} {kindMarker} - #{statusTag} - {title}",
  "ready": {
    "status": "Aguardando validacao",
    "runValidationByDefault": false,
    "validationCommands": []
  },
  "finish": {
    "status": "Validada",
    "runValidationByDefault": false,
    "validationCommands": [],
    "commitByDefault": true,
    "lockOnFinish": false
  },
  "validate": {
    "status": "Validada",
    "deprecatedAliasFor": "finish --no-commit",
    "lockOnValidate": false
  },
  "delivery": {
    "mode": "pr",
    "baseBranch": "main",
    "commit": {
      "format": "gitmoji-conventional"
    },
    "changelog": {
      "style": "fragments"
    },
    "gate": {
      "full": [
        "node node_modules/jest/bin/jest.js --ci"
      ]
    },
    "queue": {
      "conflicts": "manager"
    },
    "worktree": {
      "junctions": [
        "node_modules"
      ]
    },
    "audit": {
      "statusContext": "Auditoria registrada"
    }
  },
  "skills": {
    "ready": [
      "delivery-report"
    ],
    "quality": [
      "clean-code-review",
      "clean-architecture-guardian",
      "react-best-practices"
    ],
    "audit": [
      "pr-audit"
    ],
    "deps": [
      "pr-bump"
    ]
  },
  "autonomy": {
    "default": "pilot",
    "ceiling": "pilot",
    "solo": "on",
    "autoFinish": {
      "kinds": [
        "chore",
        "test",
        "docs",
        "refactor",
        "bug",
        "feature"
      ]
    },
    "alwaysHumanLocks": "*"
  },
  "models": {
    "enabled": "on",
    "tiers": {
      "normal": "sonnet"
    },
    "fable": "ask"
  }
}
